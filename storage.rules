rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fonctions helper
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidImageFile() {
      return request.resource.size < 10 * 1024 * 1024 && // Max 10MB
             request.resource.contentType.matches('image/.*');
    }
    
    function isValidVideoFile() {
      return request.resource.size < 100 * 1024 * 1024 && // Max 100MB
             request.resource.contentType.matches('video/.*');
    }
    
    function isValidAudioFile() {
      return request.resource.size < 20 * 1024 * 1024 && // Max 20MB
             request.resource.contentType.matches('audio/.*');
    }
    
    function isValidDocumentFile() {
      return request.resource.size < 50 * 1024 * 1024 && // Max 50MB
             (request.resource.contentType == 'application/pdf' ||
              request.resource.contentType.matches('application/.*document.*') ||
              request.resource.contentType.matches('application/.*sheet.*') ||
              request.resource.contentType.matches('application/.*presentation.*') ||
              request.resource.contentType == 'text/plain');
    }
    
    function isValidFile() {
      return isValidImageFile() || isValidVideoFile() || 
             isValidAudioFile() || isValidDocumentFile();
    }
    
    function isConversationParticipant(conversationId) {
      return isAuthenticated() && 
        firestore.exists(/databases/(default)/documents/conversations/$(conversationId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
    }
    
    // Règles pour les photos de profil
    match /users/{userId}/profile/{fileName} {
      allow read: if true; // Photos de profil publiques
      allow write: if isOwner(userId) && isValidImageFile();
      allow delete: if isOwner(userId);
    }
    
    // Règles pour les médias des conversations
    match /conversations/{conversationId}/messages/{messageId}/{fileName} {
      // Lecture : participants de la conversation
      allow read: if isConversationParticipant(conversationId);
      
      // Écriture : participants avec fichier valide
      allow create: if isConversationParticipant(conversationId) && 
                      isValidFile() &&
                      request.resource.metadata.uploadedBy == request.auth.uid;
      
      // Mise à jour : non autorisée
      allow update: if false;
      
      // Suppression : uploader ou admin du groupe
      allow delete: if isAuthenticated() && (
        resource.metadata.uploadedBy == request.auth.uid ||
        (firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.type == 'group' &&
         firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid)
      );
    }
    
    // Règles pour les miniatures
    match /conversations/{conversationId}/messages/{messageId}/thumb_{fileName} {
      // Mêmes règles que les médias principaux
      allow read: if isConversationParticipant(conversationId);
      allow write: if isConversationParticipant(conversationId) && 
                     request.resource.contentType.matches('image/.*') &&
                     request.resource.size < 1 * 1024 * 1024; // Max 1MB pour les miniatures
      allow delete: if isAuthenticated() && (
        resource.metadata.uploadedBy == request.auth.uid ||
        (firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.type == 'group' &&
         firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid)
      );
    }
    
    // Règles pour les photos de groupe
    match /groups/{groupId}/photo/{fileName} {
      // Lecture : membres du groupe
      allow read: if isAuthenticated() && 
        firestore.exists(/databases/(default)/documents/conversations/$(groupId)) &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(groupId)).data.participantIds;
      
      // Écriture : admin du groupe seulement
      allow write: if isAuthenticated() && 
        firestore.exists(/databases/(default)/documents/conversations/$(groupId)) &&
        firestore.get(/databases/(default)/documents/conversations/$(groupId)).data.createdBy == request.auth.uid &&
        isValidImageFile();
    }
    
    // Règles pour les statuts (stories)
    match /status/{userId}/{statusId}/{fileName} {
      // Lecture : contacts de l'utilisateur
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        firestore.exists(/databases/(default)/documents/users/$(userId)/contacts/$(request.auth.uid))
      );
      
      // Écriture : propriétaire seulement
      allow write: if isOwner(userId) && isValidFile();
      allow delete: if isOwner(userId);
    }
    
    // Règles pour les fichiers temporaires (uploads en cours)
    match /temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && 
                     isValidFile() &&
                     request.time < resource.timeCreated + duration.value(1, 'h'); // Expire après 1h
      allow delete: if isOwner(userId);
    }
    
    // Interdire tout accès non spécifié
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}