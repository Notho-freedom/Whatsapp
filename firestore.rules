rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fonctions helper
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isParticipant(conversation) {
      return isAuthenticated() && request.auth.uid in conversation.participantIds;
    }
    
    function isNotBlocked(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return !('blockedUsers' in userDoc.data) || !(request.auth.uid in userDoc.data.blockedUsers);
    }
    
    function isValidMessage() {
      return request.resource.data.keys().hasAll(['content', 'type', 'sender', 'timestamp']) &&
             request.resource.data.type in ['text', 'image', 'video', 'audio', 'document', 'location', 'system'] &&
             request.resource.data.sender.uid == request.auth.uid;
    }
    
    // Règles pour les utilisateurs
    match /users/{userId} {
      // Lecture : utilisateur lui-même ou utilisateurs non bloqués
      allow read: if isOwner(userId) || (isAuthenticated() && isNotBlocked(userId));
      
      // Écriture : seulement l'utilisateur lui-même
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']) // Interdire la modification de uid et email
      );
      allow delete: if isOwner(userId);
      
      // Sous-collection contacts
      match /contacts/{contactId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // Règles pour les conversations
    match /conversations/{conversationId} {
      // Lecture : seulement les participants
      allow read: if isAuthenticated() && 
        (request.auth.uid in resource.data.participantIds);
      
      // Création : utilisateur authentifié et doit être participant
      allow create: if isAuthenticated() && 
        (request.auth.uid in request.resource.data.participantIds) &&
        (request.resource.data.createdBy == request.auth.uid);
      
      // Mise à jour : participants avec restrictions
      allow update: if isParticipant(resource.data) && (
        // Seul le créateur peut modifier certains champs pour les groupes
        (!resource.data.type == 'group' || resource.data.createdBy == request.auth.uid || 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'description', 'photoURL']))
      );
      
      // Suppression : seulement le créateur pour les groupes
      allow delete: if isParticipant(resource.data) && 
        (resource.data.type != 'group' || resource.data.createdBy == request.auth.uid);
      
      // Sous-collection reads (statut de lecture)
      match /reads/{userId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow write: if isOwner(userId) && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
      }
    }
    
    // Règles pour les messages
    match /messages/{messageId} {
      // Lecture : participants de la conversation
      allow read: if isAuthenticated() && 
        isParticipant(get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data);
      
      // Création : participant et message valide
      allow create: if isAuthenticated() && 
        isParticipant(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data) &&
        isValidMessage();
      
      // Mise à jour : auteur du message (pour édition/réactions)
      allow update: if isAuthenticated() && (
        // L'auteur peut éditer son message
        (resource.data.sender.uid == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['content', 'edited', 'editedAt', 'editHistory'])) ||
        // N'importe quel participant peut ajouter des réactions
        (isParticipant(get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy']))
      );
      
      // Suppression : auteur ou admin du groupe
      allow delete: if isAuthenticated() && (
        resource.data.sender.uid == request.auth.uid ||
        (get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.type == 'group' &&
         get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.createdBy == request.auth.uid)
      );
    }
    
    // Règles pour les notifications
    match /notifications/{notificationId} {
      // Lecture/écriture : seulement le destinataire
      allow read: if isOwner(resource.data.userId);
      allow create: if false; // Créées seulement côté serveur
      allow update: if isOwner(resource.data.userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Règles pour les statuts utilisateur (stories)
    match /status/{statusId} {
      // Lecture : contacts non bloqués
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        (exists(/databases/$(database)/documents/users/$(resource.data.userId)/contacts/$(request.auth.uid)) &&
         isNotBlocked(resource.data.userId))
      );
      
      // Écriture : seulement le propriétaire
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Règles pour les appels
    match /calls/{callId} {
      // Lecture : participants de l'appel
      allow read: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      // Création : utilisateur authentifié et doit être participant
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.initiator == request.auth.uid;
      
      // Mise à jour : participants seulement
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      
      // Pas de suppression directe (archivage automatique)
      allow delete: if false;
    }
  }
}